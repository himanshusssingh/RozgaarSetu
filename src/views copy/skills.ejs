<% layout("layouts/boilerplate.ejs") %>
<body>

<div class="container py-5">
    <div class="row align-items-center">

        <!-- Page Heading -->
        <div class="text-center mb-5">
            <h1 class="fw-bold">🔥 Most Demanding Skills</h1>
            <p class="text-muted">Explore top skills that companies are actively hiring for</p>
        </div>
    
        <!-- Cards Row -->
        <div class="row g-4">
    
            <!-- Card 1 -->
            <div class="col-lg-4 col-md-6">
                <div class="card skill-card p-3">
                    <div class="card-body">
                        <h4 class="card-title fw-bold">Java Full Stack</h4>
                        <span class="badge badge-demand mb-2">High Demand</span>
    
                        <p class="mt-3">
                            Java Full Stack developers work on both backend and frontend using Java, Spring Boot, and modern UI frameworks.
                        </p>
    
                        <ul class="list-unstyled">
                            <li><strong>Skills:</strong> Java, Spring Boot, SQL, REST API</li>
                            <li><strong>Job Roles:</strong> Software Engineer</li>
                            <li><strong>Avg Salary:</strong> ₹6 – 12 LPA</li>
                            <li><strong>Top Companies:</strong> TCS, Infosys, Accenture</li>
                        </ul>
    
                        <button class="btn btn-primary w-100 mt-3">Learn More</button>
                    </div>
                </div>
            </div>
    
            <!-- Card 2 -->
            <div class="col-lg-4 col-md-6">
                <div class="card skill-card p-3">
                    <div class="card-body">
                        <h4 class="card-title fw-bold">MERN Stack</h4>
                        <span class="badge badge-demand mb-2">Very High Demand</span>
    
                        <p class="mt-3">
                            MERN Stack developers build modern web apps using JavaScript-based technologies.
                        </p>
    
                        <ul class="list-unstyled">
                            <li><strong>Skills:</strong> MongoDB, Express, React, Node.js</li>
                            <li><strong>Job Roles:</strong> Full Stack Developer</li>
                            <li><strong>Avg Salary:</strong> ₹5 – 10 LPA</li>
                            <li><strong>Top Companies:</strong> Wipro, Zoho, Startups</li>
                        </ul>
    
                        <button class="btn btn-primary w-100 mt-3">Learn More</button>
                    </div>
                </div>
            </div>
    
            <!-- Card 3 -->
            <div class="col-lg-4 col-md-6">
                <div class="card skill-card p-3">
                    <div class="card-body">
                        <h4 class="card-title fw-bold">Data Analytics</h4>
                        <span class="badge badge-demand mb-2">High Demand</span>
    
                        <p class="mt-3">
                            Data Analysts convert raw data into meaningful insights using tools and visualization techniques.
                        </p>
    
                        <ul class="list-unstyled">
                            <li><strong>Skills:</strong> SQL, Excel, Python, Tableau</li>
                            <li><strong>Job Roles:</strong> Data Analyst</li>
                            <li><strong>Avg Salary:</strong> ₹6 – 11 LPA</li>
                            <li><strong>Top Companies:</strong> Deloitte, PwC, EY</li>
                        </ul>
    
                        <button class="btn btn-primary w-100 mt-3">Learn More</button>
                    </div>
                </div>
            </div>
    
            <!-- Card 4 -->
            <div class="col-lg-4 col-md-6">
                <div class="card skill-card p-3">
                    <div class="card-body">
                        <h4 class="card-title fw-bold">Cloud Computing</h4>
                        <span class="badge badge-demand mb-2">High Demand</span>
    
                        <p class="mt-3">
                            Cloud Engineers design and manage scalable cloud infrastructure.
                        </p>
    
                        <ul class="list-unstyled">
                            <li><strong>Skills:</strong> AWS, Azure, Docker, Kubernetes</li>
                            <li><strong>Job Roles:</strong> Cloud Engineer</li>
                            <li><strong>Avg Salary:</strong> ₹7 – 15 LPA</li>
                            <li><strong>Top Companies:</strong> Amazon, Google, Microsoft</li>
                        </ul>
    
                        <button class="btn btn-primary w-100 mt-3">Learn More</button>
                    </div>
                </div>
            </div>
    
            <!-- Card 5 -->
            <div class="col-lg-4 col-md-6">
                <div class="card skill-card p-3">
                    <div class="card-body">
                        <h4 class="card-title fw-bold">Cyber Security</h4>
                        <span class="badge badge-demand mb-2">Growing Demand</span>
    
                        <p class="mt-3">
                            Cyber Security professionals protect systems and data from digital attacks.
                        </p>
    
                        <ul class="list-unstyled">
                            <li><strong>Skills:</strong> Networking, Ethical Hacking, Linux</li>
                            <li><strong>Job Roles:</strong> Security Analyst</li>
                            <li><strong>Avg Salary:</strong> ₹6 – 14 LPA</li>
                            <li><strong>Top Companies:</strong> IBM, Cisco, Infosys</li>
                        </ul>
    
                        <button class="btn btn-primary w-100 mt-3">Learn More</button>
                    </div>
                </div>
            </div>
    
            <!-- Card 6 -->
            <div class="col-lg-4 col-md-6">
                <div class="card skill-card p-3">
                    <div class="card-body">
                        <h4 class="card-title fw-bold">AI & Machine Learning</h4>
                        <span class="badge badge-demand mb-2">Very High Demand</span>
    
                        <p class="mt-3">
                            AI engineers build intelligent systems using data and algorithms.
                        </p>
    
                        <ul class="list-unstyled">
                            <li><strong>Skills:</strong> Python, ML, Deep Learning</li>
                            <li><strong>Job Roles:</strong> AI Engineer</li>
                            <li><strong>Avg Salary:</strong> ₹8 – 20 LPA</li>
                            <li><strong>Top Companies:</strong> Google, OpenAI, Microsoft</li>
                        </ul>
    
                        <button class="btn btn-primary w-100 mt-3">Learn More</button>
                    </div>
                </div>
            </div>
    
        </div>
    </div>    
</div>

</body>
