<% layout("layouts/boilerplate.ejs") %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">

      <div class="edit-card p-4">

        <h3 class="text-center fw-bold mb-4">✏️ Edit Resume</h3>

        <!-- Profile Image (Not Editable) -->
        <div class="text-center mb-4">
          <% if (resume.profile) { %>
            <img src="<%= resume.profile %>" class="profile-img">
          <% } %>
          <p class="text-muted mt-2 small">
            Profile image cannot be changed
          </p>
        </div>

        <form
          action="/resume/editResume"
          method="POST"
          class="needs-validation"
          novalidate
        >

          <div class="row">

            <div class="col-md-6 mb-3">
              <label class="form-label fw-semibold">📞 Phone</label>
              <input
                type="number"
                name="phone"
                class="form-control"
                value="<%= resume.phone %>"
                required
              >
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label fw-semibold">📍 Address</label>
              <input
                type="text"
                name="address"
                class="form-control"
                value="<%= resume.address %>"
                required
              >
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label fw-semibold">💡 Skills</label>
              <input
                type="text"
                name="skills"
                class="form-control"
                value="<%= resume.skills %>"
                required
              >
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label fw-semibold">🎓 Education</label>
              <input
                type="text"
                name="education"
                class="form-control"
                value="<%= resume.education %>"
                required
              >
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label fw-semibold">🧑‍💼 Experience</label>
              <input
                type="text"
                name="experience"
                class="form-control"
                value="<%= resume.experience %>"
                required
              >
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label fw-semibold">💪 Strength</label>
              <input
                type="text"
                name="strength"
                class="form-control"
                value="<%= resume.strength %>"
                required
              >
            </div>

            <div class="col-12 mb-3">
              <label class="form-label fw-semibold">🎯 Career Objective</label>
              <textarea
                name="careerObjective"
                class="form-control"
                rows="4"
                required
              ><%= resume.careerObjective %></textarea>
            </div>

            <div class="col-12 mb-4">
              <label class="form-label fw-semibold">🎨 Hobbies</label>
              <input
                type="text"
                name="hobbies"
                class="form-control"
                value="<%= resume.hobbies %>"
                required
              >
            </div>

          </div>

          <!-- Buttons -->
          <div class="d-flex justify-content-between flex-wrap gap-2">
            <button class="btn btn-primary btn-action">
              ✅ Update Resume
            </button>
            <a href="/resume" class="btn btn-outline-secondary btn-action">
              ❌ Cancel
            </a>
          </div>

        </form>

      </div>

    </div>
  </div>
</div>
