<% layout("layouts/boilerplate.ejs") %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">

      <div class="card shadow">
        <div class="card-body">

          <h3 class="text-center mb-4">Edit Resume</h3>

          <!-- Profile Image (NOT EDITABLE) -->
          <div class="text-center mb-4">
            <% if (resume.profile) { %>
              <img
                src="<%= resume.profile %>"
                alt="Profile Image"
                class="rounded-circle border"
                width="150"
                height="150"
              >
            <% } %>
            <p class="text-muted mt-2">Profile image cannot be changed</p>
          </div>

          <form
            action="/resume/editResume"
            method="POST"
            class="needs-validation"
            novalidate
          >

            <!-- Phone -->
            <div class="mb-3">
              <label class="form-label">Phone</label>
              <input
                type="number"
                name="phone"
                class="form-control"
                value="<%= resume.phone %>"
                required
              >
            </div>

            <!-- Address -->
            <div class="mb-3">
              <label class="form-label">Address</label>
              <input
                type="text"
                name="address"
                class="form-control"
                value="<%= resume.address %>"
                required
              >
            </div>

            <!-- Skills -->
            <div class="mb-3">
              <label class="form-label">Skills</label>
              <input
                type="text"
                name="skills"
                class="form-control"
                value="<%= resume.skills %>"
                required
              >
            </div>

            <!-- Education -->
            <div class="mb-3">
              <label class="form-label">Education</label>
              <input
                type="text"
                name="education"
                class="form-control"
                value="<%= resume.education %>"
                required
              >
            </div>

            <!-- Experience -->
            <div class="mb-3">
              <label class="form-label">Experience</label>
              <input
                type="text"
                name="experience"
                class="form-control"
                value="<%= resume.experience %>"
                required
              >
            </div>

            <!-- Career Objective -->
            <div class="mb-3">
              <label class="form-label">Career Objective</label>
              <textarea
                name="careerObjective"
                class="form-control"
                rows="3"
                required
              ><%= resume.careerObjective %></textarea>
            </div>

            <!-- Strength -->
            <div class="mb-3">
              <label class="form-label">Strength</label>
              <input
                type="text"
                name="strength"
                class="form-control"
                value="<%= resume.strength %>"
                required
              >
            </div>

            <!-- Hobbies -->
            <div class="mb-3">
              <label class="form-label">Hobbies</label>
              <input
                type="text"
                name="hobbies"
                class="form-control"
                value="<%= resume.hobbies %>"
                required
              >
            </div>

            <div class="d-flex justify-content-between">
              <button class="btn btn-primary">Update Resume</button>
              <a href="/resume" class="btn btn-secondary">Cancel</a>
            </div>

          </form>

        </div>
      </div>

    </div>
  </div>
</div>
