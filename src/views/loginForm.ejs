<% layout("layouts/boilerplate.ejs") %>

<section class="auth-page">

    <!-- LEFT HERO TEXT -->
    <div class="auth-left">
        <h1 class="hero-title">
            Welcome back<br>
            <span>Developer</span>
        </h1>

        <p class="hero-sub">
            Login to access your profile, apply to companies and
            get hired based on your real skills and projects.
        </p>

        <div class="hero-badge">
            💼 Companies are actively hiring
        </div>
    </div>


    <!-- LOGIN CARD -->
    <div class="auth-card">

        <h2>Login</h2>
        <p class="text-muted mb-4">Continue your career journey</p>

        <form action="/users/login" method="post" class="needs-validation" novalidate>

            <div class="form-group">
                <input type="text" name="username" placeholder="Username" class="form-control" required>
            </div>

            <div class="form-group">
                <input type="password" name="password" placeholder="Password" class="form-control" required>
            </div>

            <button class="btn-register">Login</button>

        </form>

        <div class="auth-links mt-3">
            New user? <a href="/users/register">Create Account</a><br>
            <a href="#">Forgot Password?</a>
        </div>

    </div>

</section>
