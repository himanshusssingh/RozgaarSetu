<% layout("layouts/boilerplate.ejs") %>

<!-- <body>
  <div class="row"> -->
    <div class="col-8 offset-2">
      <br>
      <h2>Create Resume</h2>

      <form 
        action="/resume/createResume" 
        method="POST"  
        enctype="multipart/form-data"
        class="needs-validation"
        novalidate
      >

        <!-- Profile Image -->
        <div class="mb-3">
          <label class="form-label">Profile Image</label>
          <input type="file" name="profile" class="form-control">
        </div>

        <!-- Phone -->
        <div class="mb-3">
          <label class="form-label">Phone *</label>
          <input type="number" name="phone" class="form-control" required>
          <div class="invalid-feedback">Phone is required</div>
          <div class="invalid-feedback">Please enter a valid phone number.</div>
        </div>

        <!-- Address -->
        <div class="mb-3">
          <label class="form-label">Address *</label>
          <input type="text" name="address" class="form-control" required>
          <div class="invalid-feedback">Address is required</div>
          <div class="invalid-feedback">Please enter a valid address.</div>
        </div>

        <!-- Skills -->
        <div class="mb-3">
          <label class="form-label">Skills *</label>
          <input type="text" name="skills" class="form-control" required>
          <div class="invalid-feedback">Skills are required</div>
          <div class="invalid-feedback">Please enter valid skills.</div>
        </div>

        <!-- Education -->
        <div class="mb-3">
          <label class="form-label">Education *</label>
          <input type="text" name="education" class="form-control" required>
          <div class="invalid-feedback">Education is required</div>
          <div class="invalid-feedback">Please enter valid education details.</div>
        </div>

        <!-- Experience -->
        <div class="mb-3">
          <label class="form-label">Experience *</label>
          <input type="text" name="experience" class="form-control" required>
          <div class="invalid-feedback">Experience is required</div>
          <div class="invalid-feedback">Please enter valid experience details.</div>
        </div>

        <!-- Career Objective -->
        <div class="mb-3">
          <label class="form-label">Career Objective *</label>
          <textarea name="careerObjective" class="form-control" required></textarea>
          <div class="invalid-feedback">Career objective is required</div>
          <div class="invalid-feedback">Please enter a valid career objective.</div>
        </div>

        <!-- Strength -->
        <div class="mb-3">
          <label class="form-label">Strength *</label>
          <input type="text" name="strength" class="form-control" required>
          <div class="invalid-feedback">Strength is required</div>
          <div class="invalid-feedback">Please enter valid strengths.</div>
        </div>

        <!-- Hobbies -->
        <div class="mb-3">
          <label class="form-label">Hobbies *</label>
          <input type="text" name="hobbies" class="form-control" required>
          <div class="invalid-feedback">Hobbies are required</div>
          <div class="invalid-feedback">Please enter valid hobbies.</div>
        </div>

        <button class="btn btn-primary">Save Resume</button>
        <br><br>

      </form>
    </div>
