<% layout("layouts/boilerplate.ejs") %>


<!-- HERO AND LOGIN FOR GUEST USERS -->
<% if(!currUser) { %>
<!-- HERO -->
<section class="hero">
  <div class="hero-bg"></div>

  <div class="container hero-content">
    <div class="row align-items-center">

      <!-- LEFT TEXT -->
      <div class="col-md-7">
        <h1 class="hero-heading">
          Hire by <span>Skills</span>,<br>
          Not by Resumes
        </h1>

        <p class="hero-text">
          A modern job application platform where talent meets opportunity.
          Build your career based on what you can actually do.
        </p>

        <div class="hero-cta">
          <a href="/users/register" class="btn btn-warning">Get Started</a>
          <a href="/allCompany" class="btn btn-outline-light ms-3">Browse Jobs</a>
        </div>
      </div>

      <!-- LOGIN CARD -->
      <div class="col-md-4 offset-md-1">
        <div class="glass-card">
          <h4 class="text-center fw-bold mb-4">Login</h4>

          <form action="/users/login" method="post" class="needs-validation" novalidate>
            <div class="mb-3">
              <input type="text" name="username" class="form-control" placeholder="Username" required>
              <div class="invalid-feedback">Please enter a valid username.</div>
            </div>

            <div class="mb-3">
              <input type="password" name="password" class="form-control" placeholder="Password" required>
              <div class="invalid-feedback">Please enter a valid password.</div>
            </div>

            <button class="btn btn-outline-warning w-100">Login</button>
          </form>

          <div class="text-center mt-3 small-links">
            <a href="/users/register">New User? Create account</a> <br>
            <a href="#">Forgot password?</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<% } %>

<!-- DASHBOARD FOR LOGGED IN USERS -->
<% if(currUser) { %>

<!-- HERO (AFTER LOGIN) -->
<section class="hero">
  <div class="hero-bg"></div>

  <div class="container hero-content">
    <div class="row align-items-center">

      <!-- LEFT TEXT -->
      <div class="col-lg-7 col-md-6">

        <h1 class="hero-heading">
          Welcome back, <span th:text="${user.username}">User</span> 👋
        </h1>

        <p class="hero-text">
          Your skills are your strength. Explore jobs that match your abilities,
          apply instantly, and track your applications — all in one place.
        </p>

        <div class="hero-cta">
          <% if(currUser.role === "recruiter") { %>
            <a href="/recruiter/jobs" class="btn btn-warning">View all posted Jobs</a>
            <a href="/recruiter/createJob" class="btn btn-outline-light ms-3">Post a Job  </a>
          <% } else { %>
            <a href="/company" class="btn btn-warning">Find Matching Jobs</a>
            <a href="/resume" class="btn btn-outline-light ms-3">My Resume</a>
          <% } %>
        </div>

      </div>

      <!-- USER DATA CARD INSIDE HERO -->
      <div class="col-lg-4 col-md-5 offset-md-1">
        <div class="glass-card text-center p-4">
      
          <!-- User Avatar -->
          <img src="<%= currProfile || '/images/default-user.png' %>"
               class="rounded-circle mb-3 border border-3 border-warning"
               width="150" height="150"
               alt="User Image">
      
          <h4 class="fw-bold mb-1"><%= currUser.fullname %></h4>
          <p class="text-light">@<%= currUser.username %></p>
      
          <hr class="text-light">
      
          <!-- User Info -->
          <div class="text-start small">
            <p class="m-2 fs-5"><strong>Email: </strong> <%= currUser.email %> </p>

            <% if(!currUser.isEmailVerified) { %>
            <p class="m-1 fs-7">
              <form action="/users/resendEmailVerification" method="post">
                <button class="btn btn-sm btn-outline-warning">Verify Email</button>
              </form>
            </p>
            <% }  %>

            <p class="m-2 fs-5"><strong>Joined: </strong> <%= new Date(currUser.createdAt).toDateString() %></p>
          </div>
      
          <hr class="text-light">
      
          <!-- Action Buttons -->
          <a 
            class="btn btn-warning w-100 mb-2"
            type="button"
            data-bs-toggle="modal"
            data-bs-target="#editProfileModal">
            Edit Profile
          </a>
      
          <a href="/users/logout" class="btn btn-outline-light w-100">
            Logout
          </a>
      
        </div>
      </div>

    </div>
  </div>
</section>

<% if(currUser.role === "user") { %>

  <div class="container my-5">
  
    <!-- DASHBOARD CARDS -->
    <div class="row g-4">
  
      <!-- Explore Careers -->
      <div class="reveal col-md-6 col-lg-4">
        <div class="card dashboard-card h-100">
          <div class="card-body">
            <div class="icon-circle bg-primary">
              🎯
            </div>
            <h5 class="mt-3">Explore Careers</h5>
            <p class="text-muted">Discover various career options.</p>
            <a href="/skills" class="btn btn-primary btn-sm">Explore</a>
          </div>
        </div>
      </div>
  
      <!-- Build Resume -->
      <div class="reveal col-md-6 col-lg-4">
        <div class="card dashboard-card h-100">
          <div class="card-body">
            <div class="icon-circle bg-success">
              📄
            </div>
            <h5 class="mt-3">Build Your Resume</h5>
            <p class="text-muted">Create a professional resume.</p>
            <a href="/resume/editResume" class="btn btn-success btn-sm">Get Started</a>
          </div>
        </div>
      </div>
  
      <!-- Applied Applications -->
      <div class="reveal col-md-6 col-lg-4">
        <div class="card dashboard-card h-100">
          <div class="card-body">
            <div class="icon-circle bg-warning">
              ⭐
            </div>
            <h5 class="mt-3">Applied Applications</h5>
            <p class="text-muted">Track your applied jobs.</p>
            <a href="/applications" class="btn btn-warning btn-sm">View</a>
          </div>
        </div>
      </div>
  
      <!-- Preview Resume -->
      <div class="reveal col-md-6 col-lg-4">
        <div class="card dashboard-card h-100">
          <div class="card-body">
            <div class="icon-circle bg-info">
              👁️
            </div>
            <h5 class="mt-3">Preview Resume</h5>
            <p class="text-muted">View or download your resume.</p>
            <a href="/resume" class="btn btn-info btn-sm">Preview</a>
          </div>
        </div>
      </div>
  
      <!-- Skills Tracker -->
      <div class="reveal col-md-6 col-lg-4">
        <div class="card dashboard-card h-100">
          <div class="card-body">
            <div class="icon-circle bg-secondary">
              🧠
            </div>
            <h5 class="mt-3">Skills Tracker</h5>
            <p class="text-muted">Monitor your skill growth.</p>
            <a href="/skills" class="btn btn-secondary btn-sm">Track</a>
          </div>
        </div>
      </div>
  
      <!-- Career Goals -->
      <div class="reveal col-md-6 col-lg-4">
        <div class="card dashboard-card h-100">
          <div class="card-body">
            <div class="icon-circle bg-dark">
              🚀
            </div>
            <h5 class="mt-3">Career Goals</h5>
            <p class="text-muted">Set and achieve goals.</p>
            <a href="/goals" class="btn btn-dark btn-sm">Set Goals</a>
          </div>
        </div>
      </div>
  
    </div>
  </div>

<% } %>

<% } %>


<!-- HOW IT WORKS -->
<section class="py-5 how-section">
  <div class="container section-card p-5">

    <!-- Heading -->
    <div class="text-center mb-5">
      <span class="badge bg-primary mb-2">Process</span>
      <h2 class="fw-bold display-6">How It Works</h2>
      <p class="text-muted">
        A simple 3-step journey from skills to hiring
      </p>
    </div>

    <div class="row g-4 justify-content-center">

      <% if(currUser.role === "recruiter") { %>
        <!-- Step 1 -->
        <div class="reveal col-md-4">
          <div class="how-card text-center h-100">
            <div class="step-circle bg-primary">1</div>
            <h5 class="fw-bold mt-3">Create Your Profile</h5>
            <p class="text-muted">
              Sign up and build a profile with your company’s culture, job openings, and hiring needs. Showcase your vision to attract the right talent.
            </p>
          </div>
        </div>
  
        <!-- Step 2 -->
        <div class="reveal col-md-4">
          <div class="how-card text-center h-100">
            <div class="step-circle bg-success">2</div>
            <h5 class="fw-bold mt-3">Post Jobs</h5>
            <p class="text-muted">
              Our intelligent system matches your job postings with relevant candidates based on their skills and experience.
            </p>
          </div>
        </div>
  
        <!-- Step 3 -->
        <div class="reveal col-md-4">
          <div class="how-card text-center h-100">
            <div class="step-circle bg-warning">3</div>
            <h5 class="fw-bold mt-3">Hire Top Talent</h5>
            <p class="text-muted">
              Review matched candidates, conduct interviews, and hire the best fit for your company’s success.
            </p>
          </div>
        </div>
      <% } else { %>
                <!-- Step 1 -->
        <div class="reveal col-md-4">
          <div class="how-card text-center h-100">
            <div class="step-circle bg-primary">1</div>
            <h5 class="fw-bold mt-3">Create Your Profile</h5>
            <p class="text-muted">
              Sign up and build a skill-based profile with projects,
              experience, and verified abilities.
            </p>
          </div>
        </div>
  
        <!-- Step 2 -->
        <div class="reveal col-md-4">
          <div class="how-card text-center h-100">
            <div class="step-circle bg-success">2</div>
            <h5 class="fw-bold mt-3">Get Matched</h5>
            <p class="text-muted">
              Our intelligent system matches your skills with
              relevant jobs and recruiters.
            </p>
          </div>
        </div>
  
        <!-- Step 3 -->
        <div class="reveal col-md-4">
          <div class="how-card text-center h-100">
            <div class="step-circle bg-warning">3</div>
            <h5 class="fw-bold mt-3">Apply & Get Hired</h5>
            <p class="text-muted">
              Apply with confidence, attend interviews,
              and land opportunities faster.
            </p>
          </div>
        </div>
      <% } %>

    </div>
  </div>
</section>

<!-- FEATURES -->
<section class="py-5 features-section">
  <div class="container section-card p-5">

    <!-- Heading -->
    <div class="text-center mb-5">
      <span class="badge bg-primary mb-2">Features</span>
      <h2 class="fw-bold display-6">Why Choose Us?</h2>
      <p class="text-muted">
        Built for modern candidates and smart recruiters
      </p>
    </div>

    <div class="row g-4">

      <!-- Feature Card -->
      <div class="reveal col-md-3">
