<% layout("layouts/boilerplate.ejs") %>


<!-- HERO AND LOGIN FOR GUEST USERS -->
<% if(!currUser) { %>
<!-- HERO -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">

            <!-- LEFT CONTENT -->
            <div class="col-md-7 mt-5">
                <h1 class="fw-bold display-4 animate-heading">
                    Skills Based Job <span class="text-warning">Application Portal</span>
                </h1>
                <p class="lead mt-3">
                    Discover jobs that truly match your skills and grow your career with confidence.
                </p>
                <img src="/images/first.png" class="hero-img " alt="Career">
            </div>

            <!-- LOGIN CARD -->
            <div class="col-md-4 offset-md-1">
                <div class="login-card">
                    <h4 class="text-center fw-bold mb-4">Login to Your Account</h4>

                    <form action="/users/login" method="post">
                        <div class="mb-3">
                            <label class="form-label">Username</label>
                            <input type="text" name="username" class="form-control" placeholder="Enter username" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input type="password" name="password" class="form-control" placeholder="Enter password" required>
                        </div>

                        <button class="btn btn-primary w-100 btn-login">Login</button>
                    </form>

                    <div class="text-center mt-3 links ">
                        <a href="/users/register"><b>New User? Sign Up</b></a><br>
                        <a href="#"><b>Forgot Password</b>?</a>
                    </div>
                </div>
            </div>

            <!-- <div class="p-0 m-0"> -->
              <img class="secondHero" src="/images/second.png" alt="second">
            <!-- </div> -->
        </div>
    </div>
</section>

<!-- ABOUT SECTION -->
<section id="about" class="py-5 about-section">
  <div class="container">

    <!-- Section Heading -->
    <div class="text-center mb-5">
      <span class="badge bg-primary mb-2">About Us</span>
      <h2 class="fw-bold display-6">
        Hiring Based on <span class="text-primary">Skills</span>, Not Resumes
      </h2>
      <p class="text-muted mt-2">
        We bridge the gap between real talent and real opportunities.
      </p>
    </div>

    <div class="row align-items-center">

      <!-- Left Content -->
      <div class="col-md-6">
        <h4 class="fw-bold mb-3">
          A Smarter Way to Get Hired 🚀
        </h4>

        <p class="text-muted">
          Traditional hiring ignores real talent. Our platform focuses on
          <strong>skills, projects, and practical ability</strong> so candidates
          get opportunities they truly deserve.
        </p>

        <div class="row mt-4">

          <div class="col-6 mb-3">
            <div class="about-card">
              <h5>Skill Profiles</h5>
              <p>Showcase real-world abilities</p>
            </div>
          </div>

          <div class="col-6 mb-3">
            <div class="about-card">
              <h5>Smart Matching</h5>
              <p>Jobs tailored to your skills</p>
            </div>
          </div>

          <div class="col-6">
            <div class="about-card">
              <h5>Verified Talent</h5>
              <p>Trustworthy hiring process</p>
            </div>
          </div>

          <div class="col-6">
            <div class="about-card">
              <h5>Faster Hiring</h5>
              <p>Less screening, more results</p>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Highlight Box -->
      <div class="col-md-6">
        <div class="about-highlight text-white">
          <h3 class="fw-bold mb-3">
            Why We Exist
          </h3>
          <p>
            Degrees don’t define capability. Skills do.
            Our mission is to create equal opportunities
            for everyone based on what they can build,
            design, or solve.
          </p>

          <a href="/users/register" class="btn btn-light mt-3">
            Get Started
          </a>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- HOW IT WORKS -->
<section class="py-5 how-section">
  <div class="container">

    <!-- Heading -->
    <div class="text-center mb-5">
      <span class="badge bg-primary mb-2">Process</span>
      <h2 class="fw-bold display-6">How It Works</h2>
      <p class="text-muted">
        A simple 3-step journey from skills to hiring
      </p>
    </div>

    <div class="row g-4 justify-content-center">

      <!-- Step 1 -->
      <div class="col-md-4">
        <div class="how-card text-center h-100">
          <div class="step-circle bg-primary">1</div>
          <h5 class="fw-bold mt-3">Create Your Profile</h5>
          <p class="text-muted">
            Sign up and build a skill-based profile with projects,
            experience, and verified abilities.
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="col-md-4">
        <div class="how-card text-center h-100">
          <div class="step-circle bg-success">2</div>
          <h5 class="fw-bold mt-3">Get Matched</h5>
          <p class="text-muted">
            Our intelligent system matches your skills with
            relevant jobs and recruiters.
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="col-md-4">
        <div class="how-card text-center h-100">
          <div class="step-circle bg-warning">3</div>
          <h5 class="fw-bold mt-3">Apply & Get Hired</h5>
          <p class="text-muted">
            Apply with confidence, attend interviews,
            and land opportunities faster.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- FEATURES -->
<section class="py-5 features-section">
  <div class="container">

    <!-- Heading -->
    <div class="text-center mb-5">
      <span class="badge bg-primary mb-2">Features</span>
      <h2 class="fw-bold display-6">Why Choose Us?</h2>
      <p class="text-muted">
        Built for modern candidates and smart recruiters
      </p>
    </div>

    <div class="row g-4">

      <!-- Feature Card -->
      <div class="col-md-3">
        <div class="feature-card text-center h-100">
          <h5 class="fw-bold mt-3">Skill Verification</h5>
          <p class="text-muted">
            Prove your skills with projects, tests, and real work.
          </p>
        </div>
      </div>

      <div class="col-md-3">
        <div class="feature-card text-center h-100">
          <h5 class="fw-bold mt-3">Smart Matching</h5>
          <p class="text-muted">
            Get job recommendations that match your skillset.
          </p>
        </div>
      </div>

      <div class="col-md-3">
        <div class="feature-card text-center h-100">
          <h5 class="fw-bold mt-3">Recruiter Dashboard</h5>
          <p class="text-muted">
            Powerful tools to shortlist and hire faster.
          </p>
        </div>
      </div>

      <div class="col-md-3">
        <div class="feature-card text-center h-100">
          <h5 class="fw-bold mt-3">Secure Platform</h5>
          <p class="text-muted">
            Your data is encrypted and fully protected.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- CONTACT SECTION -->
<section id="contact" class="py-5">
  <div class="container">

    <div class="text-center mb-4">
      <h2 class="fw-bold">Contact Us</h2>
      <p class="text-muted">Have questions? We'd love to hear from you</p>
    </div>

    <div class="row justify-content-center">
      <div class="col-md-6">

        <form action="/home" method="post">
          
          <div class="mb-3">
            <input type="text" name="name" class="form-control" placeholder="Your Name" required>
          </div>

          <div class="mb-3">
            <input type="email" name="email" class="form-control" placeholder="Your Email" required>
          </div>

          <div class="mb-3">
            <textarea name="message" class="form-control" rows="4" placeholder="Your Message" required></textarea>
          </div>

          <button class="btn btn-primary w-100">
            Send Message
          </button>

        </form>

      </div>
    </div>

  </div>
</section>



<% } %>

<!-- DASHBOARD FOR LOGGED IN USERS -->
<% if(currUser) { %>

  <!-- HERO -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">

            <!-- LEFT CONTENT -->
            <div class="col-md-7 mt-5">
                <h1 class="fw-bold display-4 animate-heading">
                    Skills Based Job <span class="text-warning">Application Portal</span>
                </h1>
                <p class="lead mt-3">
                    Discover jobs that truly match your skills and grow your career with confidence.
                </p>
                <img src="/images/first.png" class="hero-img " alt="Career">
            </div>

            <!-- USER DATA CARD -->
            <div class="col-md-4 offset-md-1">
                <div class="card shadow-lg">
                    <div class="card-body text-center p-4">
            
                        <!-- User Avatar -->
                        <img src="<%= currProfile || '/images/default-user.png' %>" 
                             class="rounded-circle mb-3" 
                             width="100" height="100" 
                             alt="User Image">
            
                        <h5 class="fw-bold mb-1"><%= currUser.fullname %></h5>
            
                        <hr>
            
                        <!-- User Info -->
                        <div class="text-start">
                            <p><strong>Username:</strong> <%= currUser.username %></p>
                            <p><strong>Email:</strong> <%= currUser.email %></p>
                            <p><strong>Joined On:</strong> <%= currUser.createdAt %></p>
                        </div>
            
                        <hr>
            
                        <!-- Action Buttons -->
                        <a href="/resume/editResume" class="btn btn-outline-primary w-100 mb-2">
                            Edit Profile
                        </a>
            
                        <a href="/users/logout" class="btn btn-outline-danger w-100">
                            Logout
                        </a>
            
                    </div>
                </div>
            </div>


            <!-- <div class="p-0 m-0"> -->
              <img class="secondHero" src="/images/second.png" alt="second">
            <!-- </div> -->
        </div>
    </div>
</section>

<div class="container my-5">

  <!-- DASHBOARD CARDS -->
  <div class="row g-4">

    <!-- Explore Careers -->
    <div class="col-md-6 col-lg-4">
      <div class="card dashboard-card h-100">
        <div class="card-body">
          <div class="icon-circle bg-primary">
            🎯
          </div>
          <h5 class="mt-3">Explore Careers</h5>
          <p class="text-muted">Discover various career options.</p>
          <a href="/skills" class="btn btn-primary btn-sm">Explore</a>
        </div>
      </div>
    </div>

    <!-- Build Resume -->
    <div class="col-md-6 col-lg-4">
      <div class="card dashboard-card h-100">
        <div class="card-body">
          <div class="icon-circle bg-success">
            📄
          </div>
          <h5 class="mt-3">Build Your Resume</h5>
          <p class="text-muted">Create a professional resume.</p>
          <a href="/resume/editResume" class="btn btn-success btn-sm">Get Started</a>
        </div>
      </div>
    </div>

    <!-- Applied Applications -->
    <div class="col-md-6 col-lg-4">
      <div class="card dashboard-card h-100">
        <div class="card-body">
          <div class="icon-circle bg-warning">
            ⭐
          </div>
          <h5 class="mt-3">Applied Applications</h5>
          <p class="text-muted">Track your applied jobs.</p>
          <a href="/applications" class="btn btn-warning btn-sm">View</a>
        </div>
      </div>
    </div>

    <!-- Preview Resume -->
    <div class="col-md-6 col-lg-4">
      <div class="card dashboard-card h-100">
        <div class="card-body">
          <div class="icon-circle bg-info">
            👁️
          </div>
          <h5 class="mt-3">Preview Resume</h5>
          <p class="text-muted">View or download your resume.</p>
          <a href="/resume" class="btn btn-info btn-sm">Preview</a>
        </div>
      </div>
    </div>

    <!-- Skills Tracker -->
    <div class="col-md-6 col-lg-4">
      <div class="card dashboard-card h-100">
        <div class="card-body">
          <div class="icon-circle bg-secondary">
            🧠
          </div>
          <h5 class="mt-3">Skills Tracker</h5>
          <p class="text-muted">Monitor your skill growth.</p>
          <a href="/skills" class="btn btn-secondary btn-sm">Track</a>
        </div>
      </div>
    </div>

    <!-- Career Goals -->
    <div class="col-md-6 col-lg-4">
      <div class="card dashboard-card h-100">
        <div class="card-body">
          <div class="icon-circle bg-dark">
            🚀
          </div>
          <h5 class="mt-3">Career Goals</h5>
          <p class="text-muted">Set and achieve goals.</p>
          <a href="/goals" class="btn btn-dark btn-sm">Set Goals</a>
        </div>
      </div>
    </div>

  </div>
</div>

<% } %>

