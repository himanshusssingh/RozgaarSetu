<% layout("layouts/boilerplate.ejs") %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">

      <div class="resume-card p-4">

        <!-- PROFILE -->
        <div class="text-center mb-4">
          <% if (resume.profile) { %>
            <img src="<%= resume.profile %>" class="profile-img">
          <% } else { %>
            <img src="/images/default-profile.png" class="profile-img">
          <% } %>

          <h3 class="mt-3 fw-bold"><%= user.fullname %></h3>
          <p class="text-muted mb-0"><%= user.email %></p>
        </div>

        <!-- DETAILS -->
        <div class="row">

          <div class="col-md-6">
            <div class="resume-section">
              <div class="label">📞 Phone</div>
              <div class="value"><%= resume.phone %></div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="resume-section">
              <div class="label">📍 Address</div>
              <div class="value"><%= resume.address %></div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="resume-section">
              <div class="label">💡 Skills</div>
              <div class="value"><%= resume.skills %></div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="resume-section">
              <div class="label">🎓 Education</div>
              <div class="value"><%= resume.education %></div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="resume-section">
              <div class="label">🧑‍💼 Experience</div>
              <div class="value"><%= resume.experience %></div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="resume-section">
              <div class="label">💪 Strength</div>
              <div class="value"><%= resume.strength %></div>
            </div>
          </div>

          <div class="col-12">
            <div class="resume-section">
              <div class="label">🎯 Career Objective</div>
              <div class="value mt-2"><%= resume.careerObjective %></div>
            </div>
          </div>

          <div class="col-12">
            <div class="resume-section">
              <div class="label">🎨 Hobbies</div>
              <div class="value"><%= resume.hobbies %></div>
            </div>
          </div>

        </div>

        <!-- ACTION BUTTONS -->
        <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
          <a href="/resume/editResume" class="btn btn-warning btn-action">✏️ Edit</a>
          <a href="/download-pdf" class="btn btn-outline-primary btn-action">⬇️ Download</a>
          <a href="/company" class="btn btn-success btn-action">🚀 Submit</a>
        </div>

      </div>

    </div>
  </div>
</div>
