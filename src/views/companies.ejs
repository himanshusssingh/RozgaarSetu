<% layout("layouts/boilerplate.ejs") %>

<div class="container my-4">
  <div class="row g-4 justify-content-center">
    <!-- Heading -->
    <div class="text-center mb-5">
        <h1 class="fw-bold">🔥 Top Companies </h1>
        <p class="text-muted">Explore top companies that are actively hiring </p>
    </div>

    <!-- All Companies Card -->
    <% for (let company of eligible) { %>
      <div class="reveal col-lg-4 col-md-6">
        <div class="company-card p-4 h-100">

          <!-- Company Name -->
          <h5 class="company-title text-center mb-1">
            <%= company.name %>
          </h5>

          <!-- Job Title -->
          <p class="job-title text-center mb-3">
            <%= company.jobTitle %>
          </p>

          <!-- Description -->
          <p class="text-muted small">
            <%= company.description %>
          </p>

          <hr>

          <!-- Job Info -->
          <p>
            <span class="info-label">🛠 Skills:</span>
            <span class="info-value"><%= company.requireSkills %></span>
          </p>

          <p>
            <span class="info-label">📍 Location:</span>
            <span class="info-value"><%= company.jobLocation %></span>
          </p>

          <p>
            <span class="info-label">💼 Experience:</span>
            <span class="info-value"><%= company.experience || "Fresher / Relevant" %></span>
          </p>

          <div class="mb-3">
            <span class="salary-badge">
              💰 <%= company.salary %>
            </span>
          </div>

          <!-- Apply Button -->
          <div class="text-center mt-auto">
            <button 
              class="btn btn-success apply-btn"
              data-job-id="<%= userId %><%= company._id %>"
              onclick="applyJob(this)"
              data-bs-toggle="modal"
              data-bs-target="#applyModal">
              Apply Now
            </button>
          </div>

        </div>
      </div>
    <% } %>

  </div>
</div>

<!-- APPLY MODAL -->
<div class="modal fade" id="applyModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content text-center">

      <div class="modal-header">
        <h5 class="modal-title w-100">Application Status</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <h4 class="text-success">✅ Applied Successfully</h4>
        <p>Thank you for applying. We will contact you soon.</p>
      </div>

      <div class="modal-footer justify-content-center">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
          OK
        </button>
      </div>

    </div>
  </div>
</div>
