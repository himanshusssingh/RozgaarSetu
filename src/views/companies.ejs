<% layout("layouts/boilerplate.ejs") %>
<body>
  <div class="container">
    <div class="row justify-content-center mt-2 ">
      <% for(let company of eligible){ %> 
          <div class="card col  border border-primary col-lg-3 col-md-2 m-2" >
            <div class="card-body p-3">
              <div class="card-text ">
                <h4 class="text-center"><%= company.name %></h4>  <br> <br>
                <b>Description: </b>
                <%= company.description %>  <br><br>
                <b>JobTitle: </b>
                <%= company.jobTitle %>  <br><br>
                <b>RequireSkills: </b>
                <%= company.requireSkills %>  <br><br>
                <b>Experience: </b>
                <%= company.requireSkills %>  <br><br>
                <b>JobLocation: </b>
                <%= company.jobLocation %>  <br><br>
                <b>Salary:</b>
                <%= company.salary %>  <br><br>
              </div>
              
              <div class="d-flex justify-content-center">
                <button class="btn btn-success apply-btn" data-job-id="<%= currUser %><%= company._id %>" onclick="applyJob(this)" data-bs-toggle="modal" data-bs-target="#applyModal">
                  Apply
                </button>
              </div>
            </div>
          </div>
        </a>
        <% } %>
    </div>
  </div>

<!-- Modal -->
<div class="modal fade" id="applyModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content text-center">

      <div class="modal-header">
        <h5 class="modal-title w-100">Application Status</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <h4 class="text-success">✅ Applied Successfully</h4>
        <p>Thank you for applying. We will contact you soon.</p>
      </div>

      <div class="modal-footer justify-content-center">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
          OK
        </button>
      </div>

    </div>
  </div>
</div>

</body>

