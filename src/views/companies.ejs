<% layout("layouts/boilerplate.ejs") %>
<body>
  <div class="container">
    <div class="row justify-content-center mt-2 ">
      <% for(let company of eligible){ %> 
          <div class="card col  border border-primary col-lg-3 col-md-2 m-2" >
            <div class="card-body p-3">
              <div class="card-text ">
                <h4 class="text-center"><%= company.name %></h4>  <br> <br>
                <b>Description: </b>
                <%= company.description %>  <br><br>
                <b>JobTitle: </b>
                <%= company.jobTitle %>  <br><br>
                <b>RequireSkills: </b>
                <%= company.requireSkills %>  <br><br>
                <b>Experience: </b>
                <%= company.requireSkills %>  <br><br>
                <b>JobLocation: </b>
                <%= company.jobLocation %>  <br><br>
                <b>Salary:</b>
                <%= company.salary %>  <br><br>
              </div>
              <div class="d-flex justify-content-center">
              <a 
                href="<%= company.careerLink %>" 
                target="_blank" 
                class="btn btn-primary"
              >
                Apply Now
              </a>
              </div>
            </div>
          </div>
        </a>
        <% } %>
    </div>
  </div>
</body>

