<% layout("layouts/boilerplate.ejs") %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-10">
      <div class="text-center mb-5">
        <h1 class="fw-bold">Your Jobs</h1>
        <p class="text-muted">Manage the jobs you have posted on the platform.</p>
        <a href="/recruiter/createJOb" class="btn btn-primary">Post a New Job</a>
      </div>

      <% if (!jobs || jobs.length === 0) { %>
        <div class="alert alert-info text-center">
          You have not posted any jobs yet. Click "Post a New Job" to create one.
        </div>
      <% } %>

      <div class="row g-4">
        <% jobs.forEach(function (job) { %>
          <div class="col-lg-6">
            <div class="company-card p-4 h-100">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                  <h5 class="company-title mb-1"><%= job.name %></h5>
                  <p class="job-title mb-0"><%= job.jobTitle %></p>
                </div>
                <small class="text-muted"><%= new Date(job.createdAt).toLocaleDateString() %></small>
              </div>

              <p class="text-muted small mb-3"><%= job.description %></p>

              <p>
                <span class="info-label">🛠 Skills:</span>
                <span class="info-value"><%= job.requireSkills %></span>
              </p>

              <p>
                <span class="info-label">📍 Location:</span>
                <span class="info-value"><%= job.jobLocation || "Not specified" %></span>
              </p>

              <p>
                <span class="info-label">💼 Experience:</span>
                <span class="info-value"><%= job.experience || "Fresher / Relevant" %></span>
              </p>

              <p>
                <span class="info-label">💰 Salary:</span>
                <span class="info-value"><%= job.salary || "Not disclosed" %></span>
              </p>

              <p>
                <span class="info-label">🔗 Apply Link:</span>
                <span class="info-value">
                  <a href="<%= job.careerLink %>" target="_blank" rel="noopener noreferrer"><%= job.careerLink %></a>
                </span>
              </p>

              <div class="d-flex justify-content-between mt-3">
                <a href="/recruiter/jobs/<%= job._id %>/edit" class="btn btn-warning btn-sm">Edit</a>
                <form action="/recruiter/jobs/<%= job._id %>/delete" method="POST" class="m-0">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>