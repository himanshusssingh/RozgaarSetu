<!-- Navbar -->

<nav class="navbar navbar-expand-lg sticky-top">
  <div class="container-fluid px-2 py-1">
    <a class="navbar-brand" href="/home">
        <img 
          src="<%='/images/logo.png' %>"
          alt="Profile"
          class="rounded-circle"
          width="90"
          height="50"
          style="object-fit: cover;"
        >
      RozgaarSetu</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse justify-content-end me-3" id="navbarNavDropdown">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/home' ? 'active' : '' %>" aria-current="page" href="/home">Home</a>
        </li>

        <li class="nav-item">
          <% if (currUser && currUser.role === 'recruiter') { %>
            <a class="nav-link <%= currentPath === '/recruiter/createJob' ? 'active' : '' %>" href="/recruiter/createJob">Post a Job</a>
          <% } else { %>
            <a class="nav-link <%= currentPath === '/resume' ? 'active' : '' %>" href="/resume">Resume</a>
          <% } %>
        </li>

        <li class="nav-item">
          <% if (currUser && currUser.role === "recruiter") { %>
            <a class="nav-link" <%= currentPath === '/recruiter/jobs' ? 'active' : '' %>" href="/recruiter/jobs">View all posted jobs</a>
          <% } else { %>
            <a class="nav-link <%= currentPath === '/allCompany' ? 'active' : '' %>" href="/allCompany">Companies</a>
          <% } %>
        </li>

        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/skills' ? 'active' : '' %>" href="/skills">Trending Skills</a>
        </li>

        <% if(!currUser) { %>
           <li class="nav-item"><a class="nav-link <%= currentPath === '/users/login' ? 'active' : '' %>" href="/users/login"><i class="fa-solid fa-circle-user"></i>  Login</a></li>
        <% } %>
        <% if(currUser) { %>       
           <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle active" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <img 
                  src="<%= currProfile || '/images/default-user.png' %>"
                  alt="Profile"
                  class="rounded-circle"
                  width="30"
                  height="30"
                  style="object-fit: cover;"
                >
                <span><%= currUser.fullname %></span>
              </a>
                <ul class="dropdown-menu " aria-labelledby="navbarDropdownMenuLink">
                  <li>
                     <button 
                       class="dropdown-item"
                       type="button"
                       data-bs-toggle="modal"
                       data-bs-target="#editProfileModal">
                       Edit Profile
                     </button>
                  </li>
                  
                  <li>
                    <button
                      class="dropdown-item"
                      type="button"
                      data-bs-toggle="modal"
                      data-bs-target="#updatePasswordModal">
                      Update Password
                    </button>
                  </li>

                  <li><a class="dropdown-item" href="/users/logout">Logout</a></li>
                </ul>
           </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>